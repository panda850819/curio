# HTTP server
HOST=0.0.0.0
PORT=3000

# Docker stores this file on the persistent /data volume.
# For local development, use ./data/curio.db instead.
DATABASE_PATH=/data/curio.db

# Optional override; defaults to the migrations/ directory bundled with Curio.
# MIGRATIONS_PATH=/app/migrations

# Docker network already present on personal-vps.
CURIO_NETWORK=personal-infra_private
